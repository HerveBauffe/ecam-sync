# /etc/ecam-sync/ecam-sync.env  — droits : root:ecam-sync, mode 640 (contient des secrets)
# Format : CLE=valeur, une par ligne. Pas d'espaces autour du « = ».

# --- Source ---------------------------------------------------------------
# Lien ICS complet (contient un jeton secret : ne le partagez pas)
ICS_URL=

# --- Google Calendar --------------------------------------------------------
# ID du calendrier dédié (Paramètres du calendrier > Intégrer l'agenda > ID de l'agenda)
GOOGLE_CALENDAR_ID=
# Clé JSON du compte de service
GOOGLE_CREDENTIALS_FILE=/etc/ecam-sync/google-service-account.json

# --- MQTT / Home Assistant ----------------------------------------------------
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
# MQTT_TLS=false
# MQTT_PREFIX=ecam_sync

# --- Réglages avancés (valeurs par défaut) ----------------------------------
# TIMEZONE=Europe/Brussels
# HORIZON_DAYS=800
# Refuse de supprimer plus de cette fraction des événements en une fois (garde-fou)
# MAX_DELETE_FRACTION=0.5
